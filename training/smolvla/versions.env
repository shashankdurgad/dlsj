SMOLVLM_REVISION=4cde9d208e19519c36917aa170fffc7e381aa0ad
# Hugging Face hub cache (both repos, pinned revisions) mirrored in GCS by cache_base.sh.
BASE_CACHE_URI=gs://onflow-30k-pi05-artifacts/models/smolvla/smolvla_base-5e8d12a6-smolvlm2-4cde9d20
# 3-stage dataset (pick / bring to inspection / place; 514 of 517 episodes selected). Five video streams;
# prepare_data.py keeps only wrist + top (inspect, inspect_depth and top_depth are dropped).
DATASET_URI=gs://onflow-30k-pi05-artifacts/datasets/duplo517-3stage-20261114
