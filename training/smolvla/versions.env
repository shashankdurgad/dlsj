# Pinned versions for the SmolVLA fine-tune (official LeRobot recipe).
# "Latest" as of 2026-11-14: LeRobot 0.7.0 is the newest PyPI release (same as the recorder);
# lerobot/smolvla_base main = 5e8d12a6 (2026-10-06); SmolVLM2-500M-Video-Instruct main = 4cde9d20 (2026-11-13).
LEROBOT_VERSION=0.7.0
SMOLVLA_REPO=lerobot/smolvla_base
SMOLVLA_REVISION=5e8d12a6e2975b0e5e5fce7c8caf47c371d257b6
