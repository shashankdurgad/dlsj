# Copy to config.env (git-ignored) and edit. Sourced by every script in this folder.

GCP_PROJECT=your-gcp-project-id
GCP_ZONE=us-central1-a            # pick a zone that has your GPU type and quota
VM_NAME=dlsj-trainer

# GPU options (on-demand prices vary by region, roughly):
#   smoke test : g2-standard-12 + 1x nvidia-l4 (24 GB)            ~$1/h   (pi0.5 full fine-tune will NOT fit)
#   pi0.5 1 GPU: a2-ultragpu-1g (1x A100 80 GB, accelerator implied) ~$5/h
#   pi0.5 4 GPU: a2-highgpu-4g  (4x A100 40 GB, accelerator implied) ~$15/h  (Tan's training/pi05 default: 4 GPUs x batch 8)
MACHINE_TYPE=a2-ultragpu-1g
ACCELERATOR=                      # only for N1/G2 machines, e.g. type=nvidia-l4,count=1; A2/A3 machines include their GPUs
BOOT_DISK_GB=300                  # trainer image (~20 GB) + datasets + checkpoints
SPOT=false                        # true = ~60-70% cheaper, but GCP can preempt the VM mid-training

# Physical AI trainer image: must match the Studio version on the XPS (commit 8f13241)
TRAINER_IMAGE=ghcr.io/open-edge-platform/physicalai-trainer-cuda:0.3.0-dev-8f132416

# SSH user on the VM, and the public key the XPS uses for the tunnel (created by xps_tunnel.sh setup)
VM_SSH_USER=trainer
XPS_PUBKEY_FILE=./xps_tunnel_key.pub

# Address the tunnel listens on, on the XPS: the gateway of Studio's Docker network (docker_default),
# so only the Studio container (and the XPS itself) can reach the trainer.
TUNNEL_BIND=172.18.0.1
TRAINER_PORT=8001
